#include <iostream>
using namespace std;

int main() {
    int n = 3;
    int W = 5;

    int weight[] = {2, 3, 4};
    int value[] = {10, 20, 30};

    int dp[4][6] = {0};
    
    for (int i = 1; i <= n; i++) {
        for (int w = 1; w <= W; w++) {

            if (weight[i - 1] <= w) {
                dp[i][w] = max(
                    dp[i - 1][w],
                    value[i - 1] + dp[i - 1][w - weight[i - 1]]
                );
            }
            else {
                dp[i][w] = dp[i - 1][w];
            }
        }
    }

    cout << "Maximum Value = " << dp[n][W];

    return 0;
}
