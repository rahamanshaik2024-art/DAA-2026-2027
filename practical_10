
#include <iostream>
#include <algorithm>
using namespace std;

struct Edge {
    int u, v, w;
};

int parent[10];

int find(int x) {
    if (parent[x] == x)
        return x;

    return parent[x] = find(parent[x]);
}

void unite(int u, int v) {
    parent[find(u)] = find(v);
}

int main() {
    int n, e;

    cout << "Enter number of vertices: ";
    cin >> n;

    cout << "Enter number of edges: ";
    cin >> e;

    Edge edges[50];

    cout << "Enter edges (u v weight):\n";

    for (int i = 0; i < e; i++) {
        cin >> edges[i].u
            >> edges[i].v
            >> edges[i].w;
    }

    sort(edges, edges + e,
         [](Edge a, Edge b) {
             return a.w < b.w;
         });

    for (int i = 0; i < n; i++)
        parent[i] = i;

    int totalCost = 0;
    int count = 0;

    cout << "\nMinimum Spanning Tree:\n";

    for (int i = 0; i < e && count < n - 1; i++) {

        int u = edges[i].u;
        int v = edges[i].v;
        int w = edges[i].w;

        if (find(u) != find(v)) {
            unite(u, v);

            cout << u << " - " << v
                 << " : " << w << endl;

            totalCost += w;
            count++;
        }
    }

    if (count != n - 1) {
        cout << "Graph is disconnected!\n";
    } else {
        cout << "Total Minimum Cost = "
             << totalCost << endl;
    }

    return 0;
}
