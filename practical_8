#include <iostream>
#include <vector>
#include <queue>
using namespace std;

vector<int> adj[5];
bool visited[5];


void BFS(int start)
{
    queue<int> q;
    visited[start] = true;
    q.push(start);

    cout << "BFS Traversal: ";

    while (!q.empty())
    {
        int node = q.front();
        q.pop();

        cout << node << " ";

        for (int i = 0; i < adj[node].size(); i++)
        {
            int next = adj[node][i];

            if (!visited[next])
            {
                visited[next] = true;
                q.push(next);
            }
        }
    }

    cout << endl;
}


void DFS(int node)
{
    visited[node] = true;
    cout << node << " ";

    for (int i = 0; i < adj[node].size(); i++)
    {
        int next = adj[node][i];

        if (!visited[next])
        {
            DFS(next);
        }
    }
}

int main()
{
    // Adding graph edges
    adj[0].push_back(1);
    adj[0].push_back(2);
    adj[1].push_back(0);
    adj[1].push_back(3);
    adj[1].push_back(4);
    adj[2].push_back(0);
    adj[3].push_back(1);
    adj[4].push_back(1);

    BFS(0);

   
    for (int i = 0; i < 5; i++)
        visited[i] = false;

    cout << "DFS Traversal: ";
    DFS(0);

    cout << endl;

    return 0;
}
